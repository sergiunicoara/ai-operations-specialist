# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# Provider: openai | google | anthropic  (set the key for the chosen provider only)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
OPENAI_API_KEY=your-key-here
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Safety limits for every agent run
MAX_STEPS=25
TIME_LIMIT_SECONDS=240

# Optional: price per 1M tokens (USD), used for the cost estimate if the
# framework's pricing lookup is unavailable. Check your provider's price page.
LLM_PRICE_IN_PER_M=
LLM_PRICE_OUT_PER_M=
