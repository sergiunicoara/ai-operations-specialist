# EDUCATIONAL DEMONSTRATION - every value below is fake and works ONLY against the local mock API.
# Copy to .env.local (npm run setup does this) - .env.local is git-ignored.

# STAGE A: deliberately PUBLIC. Next.js inlines NEXT_PUBLIC_ values into browser JavaScript at build time.
NEXT_PUBLIC_DEMO_EXPOSED_KEY=DEMO_ONLY_PUBLIC_VALUE_NOT_A_REAL_CREDENTIAL
NEXT_PUBLIC_DEMO_MOCK_API_URL=http://127.0.0.1:4010

# STAGE B/C: server-side only (no NEXT_PUBLIC_ prefix). Read at runtime by the Next.js route handler.
# "Demo key A" - the mock API's initial key. Rotation replaces it with "Demo key B".
DEMO_MOCK_API_KEY=DEMO_KEY_A_FAKE_MOCK_ONLY_NOT_A_REAL_CREDENTIAL
DEMO_MOCK_API_URL=http://127.0.0.1:4010

# Optional: max requests per minute accepted by the demo route (default 30).
# DEMO_ROUTE_RATE_LIMIT_PER_MIN=30
