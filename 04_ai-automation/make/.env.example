# Required once this API is reachable from anywhere but localhost (e.g.
# tunneled for Make.com) - callers must send it as the x-api-key header.
API_KEY=choose_a_long_random_value

# GEMINI_API_KEY / GEMINI_MODEL are read from ../ai-agent-demo/.env - set
# those there, not here (api.py loads both files).
